uit_pulse":{"atlas":"hive_queen_conduits","bounds":{"x":13,"y":12,"w":230,"h":232}},"hive_queen_conduit_damaged":{"atlas":"hive_queen_conduits","bounds":{"x":13,"y":12,"w":230,"h":232}},"hive_queen_conduit_destroyed":{"atlas":"hive_queen_conduits","bounds":{"x":12,"y":15,"w":232,"h":226}}},"zones":{"1":{"key":"warrens","name":"The Warrens","materials":"rust-brown and burnt umber overlapping dead ant carapace plates; chipped scalloped edges, small olive rot spots; translucent AMBER resin binding the shells. Ivory eggs, amber glowing resin knots. Matte and worn."},"2":{"key":"granary","name":"The Granary","materials":"olive-brown locust chitin coated with low grey-green shelf fungus, fungal root threads and small sage spore nodules. Muted GREEN fungal glow, dirty pale green eggs. The walls are still layered insect shell architecture, overgrown rather than replaced by giant mushrooms."},"3":{"key":"paper","name":"The Paper Hive","materials":"ochre-grey wasp paper comb architecture, thin torn layered paper fibers covering lighter dull chitin ribs, visible small irregular hexagonal recesses. Desaturated straw and warm grey with small YELLOW resin light accents; cream eggs. Fragile fibrous paper, not metal, stone, or bright gold."},"4":{"key":"boiling","name":"The Boiling Galleries","materials":"thick charcoal and iron-brown beetle shell plates, scorched chipped edges, mineral ash and tiny ORANGE hot resin seams. Heavy rugged charred chitin; small orange vent nodules, smoke-stained grey eggs. No large flames or smoke effects, those are handled separately in-game."},"5":{"key":"lantern","name":"The Lantern Deep","materials":"very dark blue-grey mantis shell and black stone armored with thin dull chitin plates and ragged silk threads. Cold grey silk-wrapped eggs, tiny sparse BLUE glow-worm threads on the resin knot only. Matte cold greys, extremely restrained blue pinpoints; no ambient neon glow."},"6":{"key":"rot","name":"The Rot Cellar","materials":"sodden olive-black roach carapace and decomposing chitin lamellae, wet dark ragged edges, dirty pale mycelium strands and small fungal nodules. Rotten grey-violet resin knot, stained ivory eggs. Muted swamp olive, charcoal and grey-violet; wet highlights tiny, no gore or piles of bodies."},"7":{"key":"royal","name":"The Royal Cell","materials":"large elegant obsidian-violet queen carapace plates arranged in layered pointed crowns, cracked purple resin seams, dusty dirty bone trim. Small VIOLET crystalline resin deposits, pale lavender ivory eggs. Regal but dead and chipped, dark muted purple and charcoal, never shiny gold or neon."},"8":{"key":"breach","name":"The Breach","materials":"drained reservoir material: dull grey broken concrete and shale clusters with muddy brown sediment, roots and a few encroaching rust-colored insect shell fragments. Cold desaturated grey, minimal amber resin infection. Muddy burrow rim, dirty cream eggs and small dull amber resin knot. Mostly natural stone and debris, still overhead and consistent with the underground painted style."}},"sources":["art/source/hive-environment/warrens.png","art/source/hive-environment/granary.png","art/source/hive-environment/paper.png","art/source/hive-environment/boiling.png","art/source/hive-environment/lantern.png","art/source/hive-environment/rot.png","art/source/hive-environment/royal.png","art/source/hive-environment/breach.png","art/source/hive-environment/floors.png","art/source/hive-environment/warrens-ribbons.png","art/source/hive-environment/queen-conduits.png"]}