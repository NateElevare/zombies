# Copy to .env for local use. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://DB_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=zombies
MONGODB_USERS_COLLECTION=users
APP_ORIGIN=https://your-deadzone-domain.example
PORT=8090
NODE_ENV=production
TRUST_PROXY=0
HOST=0.0.0.0
# For npm run dev + npm run dev:server, use NODE_ENV=development and omit APP_ORIGIN
# (or set it to the exact Vite origin, normally http://localhost:5173).
